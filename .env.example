# Copy to .env and fill in. Never commit .env.
#
# Auth for the SciSpace API. Grab from a logged-in browser session:
#   DevTools > Network > any /api/scispace-agent/* request > Copy as cURL,
#   then take the Cookie header value verbatim.
SCISPACE_COOKIE=

# Optional: sent as-is if present. Some deployments use a bearer token instead of cookies.
SCISPACE_AUTH_TOKEN=

# Politeness contact for Crossref / OpenAlex (they give better rate limits with one).
SCHOLARLY_CONTACT_EMAIL=

# Optional: raises Semantic Scholar rate limit well above the ~1 req/s anonymous cap.
SEMANTIC_SCHOLAR_API_KEY=
